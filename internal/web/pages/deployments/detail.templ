package deployments

import "time"

templ DeploymentDetailPage(deployment interface{}, app interface{}) {
	<div>
		<h1 class="text-3xl font-bold text-gray-900 mb-6">Deployment Detail</h1>
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<p class="text-gray-600">Deployment detail placeholder</p>
			<p class="text-sm text-gray-500 mt-2">Started: { time.Now().Format("2006-01-02 15:04:05") }</p>
		</div>
	</div>
}

templ DeploymentLogsPage(deployment interface{}, logs []string) {
	<div>
		<h1 class="text-3xl font-bold text-gray-900 mb-6">Deployment Logs</h1>
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<pre class="bg-gray-900 text-green-400 p-4 rounded-md overflow-auto max-h-96 text-sm font-mono">
Log output will appear here...
			</pre>
		</div>
	</div>
}
