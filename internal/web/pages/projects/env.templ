package projects

import (
	"fmt"
	"github.com/akordium-id/get-labuh/internal/models"
)

templ ProjectEnvPage(project *models.Project, vars []*models.SharedEnvVar) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
					<a href="/projects" class="hover:underline">Projects</a>
					<span>/</span>
					<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s", project.ID)) } class="hover:underline">{ project.Name }</a>
					<span>/</span>
					<span class="text-gray-900 font-medium">Shared Variables</span>
				</div>
				<h1 class="text-2xl font-bold text-gray-900">Project Shared Environment Variables</h1>
				<p class="text-sm text-gray-500 mt-1">Variabel di sini otomatis diwariskan ke seluruh aplikasi di dalam project ini (App &gt; Project &gt; Team).</p>
			</div>
		</div>

		<!-- Add Variable Card -->
		<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
			<h2 class="text-lg font-semibold text-gray-900 mb-4">Tambah Variabel Baru</h2>
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%s/env", project.ID)) } class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
				<div class="sm:col-span-4">
					<label class="block text-xs font-medium text-gray-700 mb-1">Key</label>
					<input type="text" name="key" required placeholder="DATABASE_URL" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"/>
				</div>
				<div class="sm:col-span-5">
					<label class="block text-xs font-medium text-gray-700 mb-1">Value</label>
					<input type="text" name="value" required placeholder="postgres://..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"/>
				</div>
				<div class="sm:col-span-2 flex items-center h-10">
					<label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
						<input type="checkbox" name="is_secret" value="true" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
						<span>Secret</span>
					</label>
				</div>
				<div class="sm:col-span-1">
					<button type="submit" class="w-full bg-blue-600 text-white px-3 py-2 text-sm rounded-md font-medium hover:bg-blue-700 transition-colors">Save</button>
				</div>
			</form>
		</div>

		<!-- Bulk Import Modal / Box -->
		<details class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
			<summary class="text-sm font-semibold text-gray-900 cursor-pointer select-none">Bulk Import (.env format)</summary>
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%s/env/bulk", project.ID)) } class="mt-4 space-y-3">
				<p class="text-xs text-gray-500">Tempelkan isi file .env (baris dengan format KEY=VALUE). Baris komentar (#) akan diabaikan.</p>
				<textarea name="env_content" rows="5" placeholder="KEY1=val1&#10;KEY2=val2" class="w-full font-mono text-xs px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
				<button type="submit" class="bg-gray-800 text-white px-4 py-2 text-xs font-medium rounded-md hover:bg-gray-900 transition-colors">Import Bulk</button>
			</form>
		</details>

		<!-- Variables List Table -->
		<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
			<div class="px-6 py-4 border-b border-gray-200">
				<h3 class="text-sm font-semibold text-gray-900">Daftar Variabel Aktif ({ fmt.Sprintf("%d", len(vars)) })</h3>
			</div>
			if len(vars) == 0 {
				<div class="p-8 text-center text-sm text-gray-500">
					Belum ada shared environment variable. Tambahkan di atas untuk mulai berbagi konfigurasi antar service.
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm text-gray-700">
						<thead class="bg-gray-50 text-xs text-gray-500 uppercase border-b border-gray-200">
							<tr>
								<th class="px-6 py-3">Key</th>
								<th class="px-6 py-3">Value</th>
								<th class="px-6 py-3">Type</th>
								<th class="px-6 py-3 text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-200 font-mono text-xs">
							for _, v := range vars {
								<tr class="hover:bg-gray-50">
									<td class="px-6 py-3 font-semibold text-gray-900">{ v.Key }</td>
									<td class="px-6 py-3 text-gray-600 truncate max-w-xs">
										if v.IsSecret {
											<span class="text-gray-400">••••••••••••••••</span>
										} else {
											<span>{ v.Value }</span>
										}
									</td>
									<td class="px-6 py-3">
										if v.IsSecret {
											<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-sans font-medium bg-amber-100 text-amber-800">Secret</span>
										} else {
											<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-sans font-medium bg-gray-100 text-gray-800">Plain</span>
										}
									</td>
									<td class="px-6 py-3 text-right">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%s/env/delete", project.ID)) } class="inline" onsubmit="return confirm('Hapus variabel ini?')">
											<input type="hidden" name="key" value={ v.Key }/>
											<button type="submit" class="text-red-600 hover:text-red-800 font-sans text-xs">Delete</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
