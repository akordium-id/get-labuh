package projects

import (
	"time"

	"github.com/akordium-id/get-labuh/internal/models"
	"github.com/akordium-id/get-labuh/internal/web/components"
)

templ ProjectsListPage(projects []*models.Project, envCounts map[string]int, currentPage, totalPages int, search string) {
	<div>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Projects</h1>
				<p class="text-gray-500 text-sm mt-1">Kelola project dan environment deployment aplikasi Anda.</p>
			</div>
			<a href="/projects/create" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 shadow-sm font-medium transition-colors">New Project</a>
		</div>
		<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
			<div class="p-4 border-b border-gray-200 flex items-center justify-between gap-4">
				<div class="relative w-full sm:w-80">
					<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					</div>
					<input type="text"
					       name="search"
					       placeholder="Search projects by name or slug..."
					       value={ search }
					       hx-get="/projects"
					       hx-trigger="keyup changed delay:300ms, search"
					       hx-target="#projects-container"
					       hx-indicator="#projects-search-spinner"
					       hx-push-url="true"
					       class="w-full pl-9 pr-9 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
					<div id="projects-search-spinner" class="htmx-indicator absolute inset-y-0 right-0 pr-3 flex items-center">
						@components.Spinner("sm", "blue")
					</div>
				</div>
			</div>
			<div id="projects-container">
				@ProjectsTable(projects, envCounts, currentPage, totalPages, search)
			</div>
		</div>
	</div>
}

templ ProjectsTable(projects []*models.Project, envCounts map[string]int, currentPage, totalPages int, search string) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Environments</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
					<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(projects) == 0 {
					<tr>
						<td colspan="5">
							if search != "" {
								<div class="text-center py-12">
									<div class="text-3xl mb-2">🔍</div>
									<h3 class="text-sm font-semibold text-gray-900">Tidak ada project ditemukan</h3>
									<p class="text-xs text-gray-500 mt-1">Tidak ada hasil yang cocok dengan kata kunci "{ search }".</p>
								</div>
							} else {
								@components.EmptyState("📁", "No projects yet", "Create your first project to get started", "New Project", "/projects/create")
							}
						</td>
					</tr>
				} else {
					for _, project := range projects {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm font-medium text-gray-900">{ project.Name }</div>
								if project.Description != nil && *project.Description != "" {
									<div class="text-sm text-gray-500 truncate max-w-xs">{ *project.Description }</div>
								}
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono text-xs">{ project.Slug }</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
								<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
									{ formatInt(envCounts[project.ID]) } env
								</span>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ formatRelativeTime(project.CreatedAt) }</td>
							<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
								<a href={ templ.SafeURL("/projects/" + project.ID) } class="text-blue-600 hover:text-blue-900 mr-3">View</a>
								<form action={ templ.SafeURL("/projects/" + project.ID + "/delete") } method="post" class="inline"
								      hx-on:htmx:config-request="this.querySelector('button').disabled=true;this.querySelector('button').innerHTML='<span class=\\'inline-block animate-spin rounded-full border-2 border-t-transparent border-white h-4 w-4\\'></span> Deleting...'">
									<button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
								</form>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	@components.Pagination(currentPage, totalPages, "/projects", search)
}

func formatInt(n int) string {
	if n < 0 {
		return "0"
	}
	if n == 0 {
		return "0"
	}
	var result []byte
	for n > 0 {
		digit := byte('0' + n%10)
		result = append([]byte{digit}, result...)
		n /= 10
	}
	return string(result)
}

func formatRelativeTime(t time.Time) string {
	now := time.Now()
	diff := now.Sub(t)

	if diff < time.Minute {
		return "just now"
	}
	if diff < time.Hour {
		minutes := int(diff.Minutes())
		if minutes == 1 {
			return "1 minute ago"
		}
		return formatPlural(minutes, "minute")
	}
	if diff < 24*time.Hour {
		hours := int(diff.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return formatPlural(hours, "hour")
	}
	if diff < 7*24*time.Hour {
		days := int(diff.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return formatPlural(days, "day")
	}
	return t.Format("Jan 2, 2006")
}

func formatPlural(n int, unit string) string {
	if n == 1 {
		return "1 " + unit + " ago"
	}
	return formatInt(n) + " " + unit + "s ago"
}
