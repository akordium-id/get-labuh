package compose

import (
	"github.com/akordium-id/get-labuh/internal/models"
)

templ ComposeListPage(composes []*models.ComposeApplication) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold text-gray-900">Compose Applications</h1>
			<a href="/projects/create" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">New Compose App</a>
		</div>
		<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Compose File</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
						<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					if len(composes) == 0 {
						<tr>
							<td colspan="4" class="px-6 py-4 text-center text-gray-500">No compose applications yet</td>
						</tr>
					} else {
						for _, c := range composes {
							<tr>
								<td class="px-6 py-4 whitespace-nowrap">
									<div class="text-sm font-medium text-gray-900">{ c.Name }</div>
									<div class="text-sm text-gray-500">{ c.Slug }</div>
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ c.ComposeFilePath }</td>
								<td class="px-6 py-4 whitespace-nowrap">
									<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
										{ c.Status }
									</span>
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
									<a href={ templ.SafeURL("/compose-apps/" + c.ID) } class="text-blue-600 hover:text-blue-900 mr-3">View</a>
									<a href={ templ.SafeURL("/compose-apps/" + c.ID + "/deploy") } class="text-green-600 hover:text-green-900 mr-3">Deploy</a>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ComposeDetailPage(composeApp *models.ComposeApplication) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">{ composeApp.Name }</h1>
				<p class="text-gray-600 mt-1">{ composeApp.Slug }</p>
			</div>
			<div class="flex gap-2">
				<form action={ templ.SafeURL("/compose-apps/" + composeApp.ID + "/start") } method="post" class="inline">
					<button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">Start</button>
				</form>
				<form action={ templ.SafeURL("/compose-apps/" + composeApp.ID + "/stop") } method="post" class="inline">
					<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Stop</button>
				</form>
				<a href={ templ.SafeURL("/compose-apps/" + composeApp.ID + "/deploy") } class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Deploy</a>
			</div>
		</div>

		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Compose Info</h2>
			<dl class="space-y-3">
				<div class="flex justify-between">
					<dt class="text-gray-600">Status</dt>
					<dd class="text-gray-900">{ composeApp.Status }</dd>
				</div>
				<div class="flex justify-between">
					<dt class="text-gray-600">Compose File</dt>
					<dd class="text-gray-900 font-mono text-sm">{ composeApp.ComposeFilePath }</dd>
				</div>
				if composeApp.ComposeProjectName != nil {
					<div class="flex justify-between">
						<dt class="text-gray-600">Project Name</dt>
						<dd class="text-gray-900 font-mono text-sm">{ *composeApp.ComposeProjectName }</dd>
					</div>
				}
			</dl>
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Custom Domain</h2>
			if composeApp.CustomDomain != nil && *composeApp.CustomDomain != "" {
				<dl class="space-y-3 mb-4">
					<div class="flex justify-between">
						<dt class="text-gray-600">Domain</dt>
						<dd class="text-gray-900">{ *composeApp.CustomDomain }</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">HTTPS</dt>
						<dd class="text-green-600">Enabled (via Caddy)</dd>
					</div>
				</dl>
				<form action={ templ.SafeURL("/compose-apps/" + composeApp.ID + "/domain/remove") } method="post" class="inline">
					<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Remove Domain</button>
				</form>
			} else {
				<form action={ templ.SafeURL("/compose-apps/" + composeApp.ID + "/domain") } method="post" class="space-y-4">
					<div>
						<label class="block text-sm font-medium text-gray-700">Custom Domain</label>
						<input type="text" name="custom_domain" placeholder="example.com" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" required>
					</div>
					<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Set Domain</button>
				</form>
			}
		</div>
	</div>
}

templ ComposeCreatePage() {
	<div>
		<h1 class="text-3xl font-bold text-gray-900 mb-6">New Compose Application</h1>
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<form action="/compose-apps" method="post" class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-gray-700">Name</label>
					<input type="text" name="name" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Slug</label>
					<input type="text" name="slug" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Compose File Path</label>
					<input type="text" name="compose_file_path" value="docker-compose.yml" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Compose Project Name</label>
					<input type="text" name="compose_project_name" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Custom Domain</label>
					<input type="text" name="custom_domain" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div class="flex gap-2">
					<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Create</button>
					<a href="/projects" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-300">Cancel</a>
				</div>
			</form>
		</div>
	</div>
}
