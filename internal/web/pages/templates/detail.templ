package templates

import (
	"github.com/akordium-id/get-labuh/internal/models"
)

templ TemplateDetailPage(template *models.ServiceTemplate, variables []*models.TemplateVariable, environments []*models.Environment) {
	<div>
		<div class="flex items-center gap-2 mb-4 text-sm text-gray-500">
			<a href="/templates" class="hover:text-blue-600">Templates</a>
			<span>/</span>
			<span class="text-gray-900 font-medium">{ template.Name }</span>
		</div>

		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900 flex items-center gap-2">
					<span>{ template.Name }</span>
				</h1>
				if template.Description != nil {
					<p class="text-gray-600 mt-1">{ *template.Description }</p>
				}
			</div>
			<span class="px-3 py-1 inline-flex text-xs font-semibold rounded-full bg-blue-100 text-blue-800 uppercase tracking-wider">{ template.Category }</span>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Info Template -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Template Details</h2>
				<dl class="space-y-3">
					<div class="flex justify-between">
						<dt class="text-gray-600">Source Type</dt>
						<dd class="text-gray-900 uppercase font-mono text-xs">{ template.SourceType }</dd>
					</div>
					if template.DockerImage != nil {
						<div class="flex justify-between items-center">
							<dt class="text-gray-600">Docker Image</dt>
							<dd class="text-gray-900 font-mono text-xs truncate max-w-[160px]">{ *template.DockerImage }</dd>
						</div>
					}
					<div class="flex justify-between">
						<dt class="text-gray-600">Official Template</dt>
						<dd class="text-gray-900">
							if template.IsOfficial {
								<span class="text-green-600 font-semibold text-xs">Verified</span>
							} else {
								<span class="text-gray-500 text-xs">Community</span>
							}
						</dd>
					</div>
				</dl>
			</div>

			<!-- Deploy Form -->
			<div class="lg:col-span-2 bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-2">Configure & 1-Click Deploy</h2>
				<p class="text-xs text-gray-500 mb-6">Pilih target environment dan konfigurasikan parameter layanan ini.</p>

				<form action={ templ.SafeURL("/templates/" + template.ID + "/deploy") } method="post" class="space-y-4">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Target Environment</label>
							<select name="environment_id" required class="block w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
								if len(environments) == 0 {
									<option value="">No environments found - create one in Projects first</option>
								} else {
									for _, env := range environments {
										<option value={ env.ID }>{ env.Name } ({ env.Slug })</option>
									}
								}
							</select>
						</div>
						<div>
							<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Service / App Name</label>
							<input type="text" name="name" value={ template.Name } required class="block w-full border border-gray-300 rounded px-3 py-2 text-sm"/>
						</div>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Exposed Port</label>
						<input type="number" name="app_port" value="8080" required class="block w-full border border-gray-300 rounded px-3 py-2 text-sm"/>
					</div>

					if len(variables) > 0 {
						<div class="pt-4 border-t border-gray-100">
							<h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Service Environment Variables</h3>
							<div class="space-y-3">
								for _, v := range variables {
									<div>
										<div class="flex justify-between items-center mb-1">
											<label class="block text-xs font-semibold text-gray-700">
												{ v.DisplayName }
												<span class="font-mono text-gray-400 font-normal">({ v.Key })</span>
											</label>
											if v.Required {
												<span class="text-[10px] text-red-600 uppercase font-semibold">Required</span>
											}
										</div>
										if v.Description != nil {
											<p class="text-[11px] text-gray-500 mb-1">{ *v.Description }</p>
										}
										<input type="text"
											name={ "var_" + v.Key }
											value={ getVarDefault(v.DefaultValue) }
											placeholder={ v.Key }
											class="block w-full border border-gray-300 rounded px-3 py-1.5 text-sm font-mono"/>
									</div>
								}
							</div>
						</div>
					}

					<div class="pt-4 border-t border-gray-100 flex gap-3">
						<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-colors flex items-center gap-2">
							<span>🚀 Deploy Now</span>
						</button>
						<a href="/templates" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2.5 rounded-lg text-sm transition-colors">
							Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>
}

func getVarDefault(val *string) string {
	if val == nil {
		return ""
	}
	return *val
}
