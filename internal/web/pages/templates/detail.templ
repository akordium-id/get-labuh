package templates

import (
	"github.com/akordium-id/get-labuh/internal/models"
)

templ TemplateDetailPage(template *models.ServiceTemplate, variables []*models.TemplateVariable) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">{ template.Name }</h1>
				if template.Description != nil {
					<p class="text-gray-600 mt-1">{ *template.Description }</p>
				}
			</div>
			<span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">{ template.Category }</span>
		</div>

		<div class="bg-white rounded-lg shadow border border-gray-200 p-6 mb-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Template Info</h2>
			<dl class="space-y-3">
				<div class="flex justify-between">
					<dt class="text-gray-600">Source Type</dt>
					<dd class="text-gray-900">{ template.SourceType }</dd>
				</div>
				if template.RepositoryURL != nil {
					<div class="flex justify-between">
						<dt class="text-gray-600">Repository</dt>
						<dd class="text-gray-900">{ *template.RepositoryURL }</dd>
					</div>
				}
				if template.DockerImage != nil {
					<div class="flex justify-between">
						<dt class="text-gray-600">Docker Image</dt>
						<dd class="text-gray-900">{ *template.DockerImage }</dd>
					</div>
				}
				<div class="flex justify-between">
					<dt class="text-gray-600">Official</dt>
					<dd class="text-gray-900">{ template.IsOfficial }</dd>
				</div>
			</dl>
		</div>

		if len(variables) > 0 {
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6 mb-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Variables</h2>
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Key</th>
							<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Display Name</th>
							<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Required</th>
							<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Default</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						for _, variable := range variables {
							<tr>
								<td class="px-4 py-2 text-sm text-gray-900 font-mono">{ variable.Key }</td>
								<td class="px-4 py-2 text-sm text-gray-900">{ variable.DisplayName }</td>
								<td class="px-4 py-2 text-sm text-gray-500">
									if variable.Required {
										<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Required</span>
									} else {
										<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Optional</span>
									}
								</td>
								<td class="px-4 py-2 text-sm text-gray-500">
									if variable.DefaultValue != nil {
										{ *variable.DefaultValue }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Deploy This Template</h2>
			<form action={ templ.SafeURL("/templates/" + template.ID + "/deploy") } method="post" class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-gray-700">Environment ID</label>
					<input type="text" name="environment_id" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Application Name</label>
					<input type="text" name="name" value={ template.Name } class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">App Port</label>
					<input type="number" name="app_port" value="8080" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div class="flex gap-2">
					<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Deploy Template</button>
					<a href="/templates" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-300">Cancel</a>
				</div>
			</form>
		</div>
	</div>
}
