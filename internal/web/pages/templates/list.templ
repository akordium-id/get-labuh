package templates

import (
	"strings"

	"github.com/akordium-id/get-labuh/internal/models"
)

func getCategoryBadgeClass(cat models.TemplateCategory) string {
	switch strings.ToLower(string(cat)) {
	case "database":
		return "bg-purple-100 text-purple-800 border-purple-200"
	case "storage":
		return "bg-sky-100 text-sky-800 border-sky-200"
	case "security":
		return "bg-red-100 text-red-800 border-red-200"
	case "search":
		return "bg-amber-100 text-amber-800 border-amber-200"
	case "automation":
		return "bg-emerald-100 text-emerald-800 border-emerald-200"
	case "monitoring":
		return "bg-indigo-100 text-indigo-800 border-indigo-200"
	default:
		return "bg-gray-100 text-gray-800 border-gray-200"
	}
}

func getServiceIcon(name string) string {
	switch strings.ToLower(name) {
	case "redis":
		return "🔴"
	case "minio":
		return "🪣"
	case "hashicorp vault", "vault":
		return "🔐"
	case "meilisearch":
		return "⚡"
	case "n8n":
		return "🔀"
	case "uptime kuma":
		return "📊"
	case "postgresql":
		return "🐘"
	case "mysql":
		return "🐬"
	default:
		return "📦"
	}
}

templ TemplatesListPage(templateList []*models.ServiceTemplate) {
	<div>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Service Catalog</h1>
				<p class="text-gray-600 mt-1">One-click deploy template layanan populer siap pakai (Redis, MinIO, Vault, Meilisearch, dll.).</p>
			</div>
		</div>

		if len(templateList) == 0 {
			<div class="bg-white rounded-lg shadow border border-dashed border-gray-300 p-12 text-center">
				<p class="text-gray-500 text-base">Belum ada service template yang tersedia.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
				for _, template := range templateList {
					<div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all duration-200 flex flex-col justify-between p-5">
						<div>
							<div class="flex items-start justify-between gap-3 mb-3">
								<div class="w-12 h-12 rounded-xl bg-gray-50 border border-gray-200 flex items-center justify-center text-2xl shadow-inner">
									{ getServiceIcon(template.Name) }
								</div>
								<div class="flex gap-1.5 flex-wrap justify-end">
									<span class={ "px-2.5 py-0.5 rounded-full text-xs font-medium border " + getCategoryBadgeClass(template.Category) }>
										{ template.Category }
									</span>
									if template.IsOfficial {
										<span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-50 text-green-700 border border-green-200">
											Official
										</span>
									}
								</div>
							</div>

							<h3 class="text-lg font-bold text-gray-900">{ template.Name }</h3>
							if template.Description != nil {
								<p class="text-gray-600 text-xs mt-1.5 line-clamp-3 leading-relaxed">
									{ *template.Description }
								</p>
							}

							if template.DockerImage != nil {
								<div class="mt-3 inline-flex items-center gap-1.5 px-2 py-1 rounded bg-gray-50 border border-gray-200 text-gray-500 text-[11px] font-mono">
									<span>🐳</span>
									<span class="truncate max-w-[180px]">{ *template.DockerImage }</span>
								</div>
							}
						</div>

						<div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
							<a href={ templ.SafeURL("/templates/" + template.ID) } class="w-full text-center bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-1.5">
								<span>🚀 1-Click Deploy</span>
							</a>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

