package lite

import (
	"github.com/akordium-id/get-labuh/internal/models"
)

templ LiteDashboardPage(userName string, apps []*models.Application) {
	<div>
		<!-- Welcome & Quick Action Header -->
		<div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-gray-200 gap-4">
			<div>
				<div class="flex items-center gap-2">
					<span class="text-2xl">👋</span>
					<h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Halo, { userName }</h1>
				</div>
				<p class="text-gray-600 text-sm mt-1">
					Deploy aplikasi Anda dalam hitungan detik tanpa ribet konfigurasi server.
				</p>
			</div>
			<div class="flex items-center gap-3">
				<a href="/templates" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-50 shadow-xs transition-colors">
					<span>📦</span>
					<span>Katalog 1-Click</span>
				</a>
				<button @click="$dispatch('open-lite-deploy-modal')" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 shadow-sm transition-colors">
					<span>⚡</span>
					<span>Deploy Aplikasi Baru</span>
				</button>
			</div>
		</div>

		<!-- The Magic Dropzone / Quick Deploy Banner -->
		<div class="mb-10 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
			<div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
				<svg class="w-80 h-80 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
			</div>
			<div class="max-w-2xl relative z-10">
				<span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-xs text-xs font-bold uppercase tracking-wider mb-3">
					Vibecoder Superpower
				</span>
				<h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
					Punya source code dari Cursor atau Bolt.new?
				</h2>
				<p class="mt-2 text-blue-100 text-sm sm:text-base leading-relaxed">
					Tarik folder atau file ZIP proyek Anda ke Labuh. Kami yang mendeteksi bahasa pemrograman, menyiapkan container, dan menyalakan domain HTTPS secara otomatis.
				</p>
				<div class="mt-6 flex flex-wrap items-center gap-4">
					<button @click="$dispatch('open-lite-deploy-modal')" class="px-5 py-2.5 bg-white text-blue-600 font-bold rounded-lg text-sm hover:bg-blue-50 shadow-md transition-all flex items-center gap-2">
						<span>📂</span>
						<span>Upload ZIP / Drop Folder</span>
					</button>
					<span class="text-xs text-blue-200">
						Mendukung Node.js, Python, PHP, Go, & Static Web
					</span>
				</div>
			</div>
		</div>

		<!-- Application Cards List -->
		<div>
			<div class="flex items-center justify-between mb-4">
				<h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
					<span>🚀</span>
					<span>Aplikasi Aktif ({ formatInt(len(apps)) })</span>
				</h3>
			</div>

			if len(apps) == 0 {
				<div class="bg-white border-2 border-dashed border-gray-300 rounded-2xl p-12 text-center">
					<div class="mx-auto w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center text-3xl mb-4">
						🌱
					</div>
					<h4 class="text-lg font-bold text-gray-900">Belum ada aplikasi yang berjalan</h4>
					<p class="text-gray-500 text-sm max-w-md mx-auto mt-1 mb-6">
						Mulai deploy proyek pertama Anda sekarang, atau gunakan katalog siap pakai untuk Redis, MinIO, atau database.
					</p>
					<button @click="$dispatch('open-lite-deploy-modal')" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors shadow-xs">
						Luncurkan Aplikasi Pertama
					</button>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, app := range apps {
						<div class="bg-white rounded-xl border border-gray-200 shadow-xs hover:shadow-md transition-all p-5 flex flex-col justify-between">
							<div>
								<div class="flex items-start justify-between gap-3 mb-3">
									<div class="flex items-center gap-2.5">
										<div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
											{ string([]rune(app.Name)[0:1]) }
										</div>
										<div>
											<h4 class="font-bold text-gray-900 leading-tight">{ app.Name }</h4>
											<p class="text-xs text-gray-400 font-mono mt-0.5">{ app.Slug }</p>
										</div>
									</div>
									if string(app.Status) == "running" {
										<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
											<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
											Aktif
										</span>
									} else {
										<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
											{ string(app.Status) }
										</span>
									}
								</div>

								if app.CustomDomain != nil && *app.CustomDomain != "" {
									<div class="mt-3 mb-4 p-2.5 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-between">
										<span class="text-xs text-gray-500 truncate max-w-[200px] font-mono">
											https://{ *app.CustomDomain }
										</span>
										<a href={ templ.SafeURL("https://" + *app.CustomDomain) } target="_blank" class="text-xs text-blue-600 hover:text-blue-800 font-semibold flex items-center gap-1">
											<span>Buka</span>
											<span>↗</span>
										</a>
									</div>
								}
							</div>

							<div class="pt-4 border-t border-gray-100 flex items-center justify-between mt-2">
								<a href={ templ.SafeURL("/applications/" + app.ID) } class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1">
									<span>Kelola Aplikasi</span>
									<span>→</span>
								</a>
								<form action={ templ.SafeURL("/applications/" + app.ID + "/restart") } method="post" class="inline m-0">
									<button type="submit" class="text-xs text-gray-500 hover:text-gray-900 font-medium px-2 py-1 rounded hover:bg-gray-100 transition-colors">
										🔄 Restart
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- Modal Deploy Lite (Interactive Magic Dropzone) -->
		<div x-data="{ open: false, isDragging: false, isUploading: false, fileName: '' }"
		     @open-lite-deploy-modal.window="open = true"
		     x-show="open"
		     style="display: none;"
		     class="relative z-50">
			<div class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs transition-opacity" @click="open = false"></div>
			<div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
				<div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-gray-100" @click.away="open = false">
					<div class="flex items-center justify-between pb-3 border-b border-gray-100">
						<div class="flex items-center gap-2">
							<span class="text-xl">⚡</span>
							<h3 class="font-bold text-lg text-gray-900">Luncurkan Aplikasi Baru</h3>
						</div>
						<button @click="open = false" class="text-gray-400 hover:text-gray-600 text-lg font-bold">×</button>
					</div>

					<form action="/lite/deploy/upload"
					      method="post"
					      enctype="multipart/form-data"
					      hx-post="/lite/deploy/upload"
					      hx-encoding="multipart/form-data"
					      hx-indicator="#upload-spinner"
					      @submit="isUploading = true"
					      class="mt-5 space-y-4">
						<!-- Drag and Drop Target Area -->
						<div @dragover.prevent="isDragging = true"
						     @dragleave.prevent="isDragging = false"
						     @drop.prevent="isDragging = false; $refs.fileInput.files = $event.dataTransfer.files; if($refs.fileInput.files.length) { fileName = $refs.fileInput.files[0].name; if(!$refs.nameInput.value) $refs.nameInput.value = fileName.replace(/\.[^/.]+$/, ''); }"
						     @click="$refs.fileInput.click()"
						     :class="isDragging ? 'border-blue-500 bg-blue-100/50 scale-[1.01]' : 'border-blue-300 bg-blue-50/40 hover:bg-blue-50/70'"
						     class="border-2 border-dashed rounded-xl p-8 text-center transition-all cursor-pointer">
							<input type="file"
							       name="file"
							       x-ref="fileInput"
							       accept=".zip"
							       required
							       class="hidden"
							       @change="if($refs.fileInput.files.length) { fileName = $refs.fileInput.files[0].name; if(!$refs.nameInput.value) $refs.nameInput.value = fileName.replace(/\.[^/.]+$/, ''); }">
							<span class="text-4xl block mb-2" x-text="fileName ? '📦' : '📂'">📂</span>
							<template x-if="fileName">
								<div>
									<p class="font-bold text-sm text-blue-700" x-text="fileName"></p>
									<p class="text-xs text-gray-500 mt-0.5">Klik untuk mengganti file ZIP</p>
								</div>
							</template>
							<template x-if="!fileName">
								<div>
									<p class="font-bold text-sm text-gray-800">Tarik & Lepas File .ZIP Proyek di Sini</p>
									<p class="text-xs text-gray-500 mt-1">Hasil export Cursor, Bolt.new, v0, atau Lovable</p>
									<span class="mt-3 inline-block px-3 py-1 bg-white border border-gray-200 rounded-full text-xs font-semibold text-gray-600 shadow-2xs">
										Pilih File dari Komputer
									</span>
								</div>
							</template>
						</div>

						<div>
							<label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nama Aplikasi</label>
							<input type="text"
							       name="name"
							       x-ref="nameInput"
							       placeholder="misal: Toko Kopi Mantap"
							       required
							       class="w-full text-sm px-3.5 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
						</div>

						<div class="pt-2">
							<button type="submit"
							        :disabled="isUploading"
							        class="w-full inline-flex justify-center items-center gap-2 py-3 px-4 bg-blue-600 text-white rounded-lg font-bold text-sm hover:bg-blue-700 disabled:opacity-75 disabled:cursor-not-allowed shadow-sm transition-colors">
								<span id="upload-spinner" class="htmx-indicator inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
								<span x-text="isUploading ? 'Mengunggah & Menganalisis Stack...' : '⚡ Luncurkan Sekarang'">⚡ Luncurkan Sekarang</span>
							</button>
						</div>
					</form>

					<div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
						<span>Atau butuh service siap pakai?</span>
						<a href="/templates" class="text-blue-600 hover:text-blue-800 font-bold">
							Buka Katalog Templates →
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}

func formatInt(n int) string {
	if n <= 0 {
		return "0"
	}
	var result []byte
	for n > 0 {
		digit := byte('0' + n%10)
		result = append([]byte{digit}, result...)
		n /= 10
	}
	return string(result)
}
