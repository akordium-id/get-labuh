package pages

templ LoginPage() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Labuh - Login</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://unpkg.com/htmx.org@2.0.0"></script>
		<script>
			document.addEventListener('htmx:configRequest', function(evt) {
				var match = document.cookie.match(new RegExp('(^| )csrf_token=([^;]+)'));
				if (match) {
					evt.detail.headers['X-CSRF-Token'] = decodeURIComponent(match[2]);
				}
			});
		</script>
	</head>
	<body class="bg-gray-50 flex items-center justify-center min-h-screen">
		<div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
			<h1 class="text-2xl font-bold mb-6 text-center">Labuh Login</h1>
			<form hx-post="/auth/login" hx-target="#login-error" hx-swap="innerHTML">
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
				</div>
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
					<input type="password" name="password" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
				</div>
				<div id="login-error"></div>
				<button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">Login</button>
			</form>
		</div>
	</body>
	</html>
}
