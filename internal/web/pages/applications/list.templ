package applications

import (
	"strconv"

	"github.com/akordium-id/get-labuh/internal/models"
	"github.com/akordium-id/get-labuh/internal/web/components"
)

templ ApplicationsListPage(apps []*models.Application, currentPage, totalPages int, search, baseURL string) {
	<div>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Applications</h1>
				<p class="text-gray-500 text-sm mt-1">Kelola instance dan deployment aplikasi di environment ini.</p>
			</div>
			<a href={ templ.SafeURL(baseURL + "/new") } class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 shadow-sm font-medium transition-colors">New Application</a>
		</div>
		<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
			<div class="p-4 border-b border-gray-200 flex items-center justify-between gap-4">
				<div class="relative w-full sm:w-80">
					<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					</div>
					<input type="text"
					       name="search"
					       placeholder="Search applications by name or slug..."
					       value={ search }
					       hx-get={ baseURL }
					       hx-trigger="keyup changed delay:300ms, search"
					       hx-target="#applications-container"
					       hx-indicator="#applications-search-spinner"
					       hx-push-url="true"
					       class="w-full pl-9 pr-9 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
					<div id="applications-search-spinner" class="htmx-indicator absolute inset-y-0 right-0 pr-3 flex items-center">
						@components.Spinner("sm", "blue")
					</div>
				</div>
			</div>
			<div id="applications-container">
				@ApplicationsTable(apps, currentPage, totalPages, search, baseURL)
			</div>
		</div>
	</div>
}

templ ApplicationsTable(apps []*models.Application, currentPage, totalPages int, search, baseURL string) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Port</th>
					<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(apps) == 0 {
					<tr>
						<td colspan="5">
							if search != "" {
								<div class="text-center py-12">
									<div class="text-3xl mb-2">🔍</div>
									<h3 class="text-sm font-semibold text-gray-900">Tidak ada aplikasi ditemukan</h3>
									<p class="text-xs text-gray-500 mt-1">Tidak ada hasil yang cocok dengan kata kunci "{ search }".</p>
								</div>
							} else {
								@components.EmptyState("📦", "No applications yet", "Get started by creating your first application", "Create Application", baseURL + "/new")
							}
						</td>
					</tr>
				} else {
					for _, app := range apps {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm font-medium text-gray-900">{ app.Name }</div>
								<div class="text-sm text-gray-500 font-mono text-xs">{ app.Slug }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ app.SourceType }</td>
							<td class="px-6 py-4 whitespace-nowrap">
								@components.StatusBadge(string(app.Status))
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono text-xs">{ formatInt(app.AppPort) }</td>
							<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
								<a href={ templ.SafeURL("/applications/" + app.ID) } class="text-blue-600 hover:text-blue-900 mr-3">View</a>
								<a href={ templ.SafeURL("/applications/" + app.ID + "/deploy") } class="text-green-600 hover:text-green-900 mr-3">Deploy</a>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	@components.Pagination(currentPage, totalPages, baseURL, search)
}

func formatInt(n int) string {
	if n < 0 {
		return "0"
	}
	if n == 0 {
		return "0"
	}
	var result []byte
	for n > 0 {
		digit := byte('0' + n%10)
		result = append([]byte{digit}, result...)
		n /= 10
	}
	return string(result)
}

func formatCPULimit(val *float64) string {
	if val == nil || *val <= 0 {
		return ""
	}
	return strconv.FormatFloat(*val, 'f', -1, 64)
}

func formatMemLimit(val *int64) string {
	if val == nil || *val <= 0 {
		return ""
	}
	return strconv.FormatInt(*val, 10)
}

func formatHealthcheckTimeout(val *int) string {
	if val == nil || *val <= 0 {
		return "30"
	}
	return strconv.Itoa(*val)
}

func getStrVal(val *string, defaultVal string) string {
	if val == nil || *val == "" {
		return defaultVal
	}
	return *val
}

templ ApplicationDetailPage(app *models.Application, deployments []*models.Deployment, envVars []*models.AppEnvVar) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">{ app.Name }</h1>
				<p class="text-gray-600 mt-1 font-mono text-sm">{ app.Slug }</p>
			</div>
			<div class="flex items-center gap-2">
				<form action={ templ.SafeURL("/applications/" + app.ID + "/start") } method="post" class="inline"
				      hx-on:htmx:config-request="this.querySelector('button').disabled=true;this.querySelector('button').classList.add('opacity-70');this.querySelector('button').innerHTML='<span class=\\'inline-block animate-spin rounded-full border-2 border-t-transparent border-white h-4 w-4 mr-1.5\\'></span>Starting...'">
					<button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 shadow-sm font-medium flex items-center transition-colors">Start</button>
				</form>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/stop") } method="post" class="inline"
				      hx-on:htmx:config-request="this.querySelector('button').disabled=true;this.querySelector('button').classList.add('opacity-70');this.querySelector('button').innerHTML='<span class=\\'inline-block animate-spin rounded-full border-2 border-t-transparent border-white h-4 w-4 mr-1.5\\'></span>Stopping...'">
					<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 shadow-sm font-medium flex items-center transition-colors">Stop</button>
				</form>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/restart") } method="post" class="inline"
				      hx-on:htmx:config-request="this.querySelector('button').disabled=true;this.querySelector('button').classList.add('opacity-70');this.querySelector('button').innerHTML='<span class=\\'inline-block animate-spin rounded-full border-2 border-t-transparent border-white h-4 w-4 mr-1.5\\'></span>Restarting...'">
					<button type="submit" class="bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700 shadow-sm font-medium flex items-center transition-colors">Restart</button>
				</form>
				<a href={ templ.SafeURL("/applications/" + app.ID + "/deploy") } class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 shadow-sm font-medium flex items-center transition-colors">Deploy</a>
				if app.ContainerID != nil && *app.ContainerID != "" {
					<a href={ templ.SafeURL("/applications/" + app.ID + "/terminal") } target="_blank" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-900 flex items-center gap-1.5 font-medium shadow-sm transition-colors">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
						Terminal
					</a>
				}
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Application Info</h2>
				<dl class="space-y-3">
					<div class="flex justify-between items-center">
						<dt class="text-gray-600">Status</dt>
						<dd>
							@components.PollingStatusBadge(string(app.Status), "/applications/" + app.ID + "/status")
						</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">Source Type</dt>
						<dd class="text-gray-900">{ app.SourceType }</dd>
					</div>
					if app.RepositoryURL != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Repository</dt>
							<dd class="text-gray-900">{ *app.RepositoryURL }</dd>
						</div>
					}
					if app.DockerImage != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Image</dt>
							<dd class="text-gray-900">{ *app.DockerImage }</dd>
						</div>
					}
					<div class="flex justify-between">
						<dt class="text-gray-600">App Port</dt>
						<dd class="text-gray-900">{ app.AppPort }</dd>
					</div>
					if app.ContainerID != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Container ID</dt>
							<dd class="text-gray-900 font-mono text-sm">{ *app.ContainerID }</dd>
						</div>
					}
				</dl>
			</div>

			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Custom Domain</h2>
				if app.CustomDomain != nil {
					<dl class="space-y-3 mb-4">
						<div class="flex justify-between">
							<dt class="text-gray-600">Domain</dt>
							<dd class="text-gray-900">{ *app.CustomDomain }</dd>
						</div>
						<div class="flex justify-between">
							<dt class="text-gray-600">HTTPS</dt>
							<dd class="text-green-600">Enabled (via Caddy)</dd>
						</div>
					</dl>
					<form action={ templ.SafeURL("/applications/" + app.ID + "/domain/remove") } method="post" class="inline">
						<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Remove Domain</button>
					</form>
				} else {
					<form action={ templ.SafeURL("/applications/" + app.ID + "/domain") } method="post" class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700">Custom Domain</label>
							<input type="text" name="custom_domain" placeholder="example.com" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" required>
						</div>
						<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Set Domain</button>
					</form>
				}
			</div>

			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-1">Resource Limits</h2>
				<p class="text-xs text-gray-500 mb-4">Batas CPU & RAM container (Live update)</p>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/resources") } method="post" class="space-y-3">
					<div>
						<label class="block text-xs font-semibold text-gray-700">CPU Limit (Cores, e.g. 0.5, 1.0)</label>
						<input type="number" step="0.1" min="0.1" name="cpu_limit"
							value={ formatCPULimit(app.CPULimit) }
							placeholder="Unlimited (e.g. 1.0)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Memory Limit (MB, e.g. 512, 1024)</label>
						<input type="number" min="32" name="memory_limit"
							value={ formatMemLimit(app.MemoryLimit) }
							placeholder="Unlimited (e.g. 512)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Memory Reservation / Soft Limit (MB)</label>
						<input type="number" min="16" name="memory_reservation"
							value={ formatMemLimit(app.MemoryReservation) }
							placeholder="Optional (e.g. 256)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 rounded-md">
						Save & Apply Limits
					</button>
				</form>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<div class="flex items-center gap-2 mb-1">
					<svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<h2 class="text-xl font-bold text-gray-900">Custom Healthcheck</h2>
				</div>
				<p class="text-xs text-gray-500 mb-4">Ubah path endpoint dan batas waktu evaluasi kesiapan container sebelum traffic dialihkan (Zero-Downtime gate).</p>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/healthcheck") } method="post" class="space-y-3">
					<div>
						<label class="block text-xs font-semibold text-gray-700">Healthcheck HTTP Path</label>
						<input type="text" name="healthcheck_path"
							value={ getStrVal(app.HealthcheckPath, "/") }
							placeholder="/"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
						<span class="text-[11px] text-gray-400 mt-0.5 block">Contoh: /, /healthz, /api/health</span>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Healthcheck Timeout (Detik)</label>
						<input type="number" min="5" max="300" name="healthcheck_timeout"
							value={ formatHealthcheckTimeout(app.HealthcheckTimeout) }
							placeholder="30"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
						<span class="text-[11px] text-gray-400 mt-0.5 block">Waktu maksimal menunggu container menjawab HTTP status &lt; 500 (Default: 30s)</span>
					</div>
					<button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium py-2 rounded-md transition-colors">
						Simpan Konfigurasi Healthcheck
					</button>
				</form>
			</div>

			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<div class="flex items-center gap-2 mb-1">
					<svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
					<h2 class="text-xl font-bold text-gray-900">HTTP Basic Auth (Caddy)</h2>
				</div>
				<p class="text-xs text-gray-500 mb-4">Lindungi endpoint aplikasi dengan otentikasi login browser HTTP Basic via Caddy proxy.</p>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/basic-auth") } method="post" class="space-y-3">
					<div>
						<label class="block text-xs font-semibold text-gray-700">Username</label>
						<input type="text" name="basic_auth_user"
							value={ getStrVal(app.BasicAuthUser, "") }
							placeholder="Kosongkan jika dinonaktifkan"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Password</label>
						<input type="password" name="basic_auth_password"
							value={ getStrVal(app.BasicAuthPassword, "") }
							placeholder="Kosongkan jika dinonaktifkan"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
						<span class="text-[11px] text-gray-400 mt-0.5 block">Di-hash secara aman dengan bcrypt sebelum dikirim ke Caddy Admin API. Kosongkan username &amp; password untuk menonaktifkan.</span>
					</div>
					<button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 rounded-md transition-colors">
						Simpan &amp; Terapkan Basic Auth
					</button>
				</form>
			</div>
		</div>

		<div class="mt-6">
			<div id="metrics-card" hx-get={ templ.SafeURL("/applications/" + app.ID + "/stats") } hx-trigger="load, every 3s" hx-swap="outerHTML">
				<div class="bg-white rounded-lg shadow border border-gray-200 p-6 flex items-center justify-between">
					<span class="text-sm text-gray-500 flex items-center gap-2">
						@components.Spinner("sm", "blue")
						Connecting to container metrics...
					</span>
				</div>
			</div>
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<div class="flex justify-between items-center mb-4">
				<div>
					<h2 class="text-xl font-bold text-gray-900">Git Webhook & Auto-Deploy</h2>
					<p class="text-xs text-gray-500 mt-1">Otomatiskan deploy setiap kali ada push commit ke target branch.</p>
				</div>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/webhook/regenerate") } method="post" class="inline">
					<button type="submit" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded border border-gray-300 font-medium">
						Regenerate Secret
					</button>
				</form>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
				<div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
					<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">GitHub Webhook URL</span>
					<div class="flex items-center gap-2">
						<input type="text" readonly value={ "/webhooks/github/" + app.ID } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
					</div>
					<span class="text-[11px] text-gray-400 mt-1 block">Content type: application/json • Secret token: required</span>
				</div>
				<div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
					<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">GitLab Webhook URL</span>
					<div class="flex items-center gap-2">
						<input type="text" readonly value={ "/webhooks/gitlab/" + app.ID } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
					</div>
					<span class="text-[11px] text-gray-400 mt-1 block">Trigger: Push events • Secret token: required</span>
				</div>
			</div>

			<div class="p-3 bg-gray-50 rounded-lg border border-gray-200 mb-4">
				<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">Webhook Secret</span>
				if app.WebhookSecret != nil && *app.WebhookSecret != "" {
					<input type="text" readonly value={ *app.WebhookSecret } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
				} else {
					<span class="text-xs text-amber-600 italic">Belum ada secret. Klik Regenerate Secret di atas untuk mengaktifkannya.</span>
				}
			</div>

			<div class="text-xs text-gray-500 bg-blue-50 border border-blue-200 rounded p-3">
				<strong class="text-blue-800">Petunjuk Konfigurasi:</strong>
				<ul class="list-disc list-inside mt-1 space-y-1 text-blue-700">
					<li><strong>GitHub:</strong> Buka Repo Settings &rarr; Webhooks &rarr; Add Webhook. Masukkan URL GitHub di atas, pilih Content type: <code class="bg-blue-100 px-1 py-0.5 rounded">application/json</code>, isi Secret, dan pilih event <em>Just the push event</em>.</li>
					<li><strong>GitLab:</strong> Buka Repo Settings &rarr; Webhooks. Masukkan URL GitLab, paste Secret Token, dan centang event <em>Push events</em>.</li>
					<li><strong>Filter Otomatis:</strong> Push ke branch lain akan diabaikan tanpa error demi menghemat resource server.</li>
				</ul>
			</div>
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<div class="flex justify-between items-center mb-4">
				<div>
					<h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
						<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						Recent Deployments &amp; Instant Rollback
					</h2>
					<p class="text-xs text-gray-500 mt-1">Sistem menyimpan cache 5 image sukses terakhir (Coolify-style) untuk rollback instan tanpa git clone/re-build.</p>
				</div>
			</div>
			if len(deployments) == 0 {
				<p class="text-sm text-gray-500 italic py-4 text-center">Belum ada riwayat deployment untuk aplikasi ini.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Deployment ID</th>
								<th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
								<th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Cached Image</th>
								<th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Commit / Info</th>
								<th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
								<th class="px-4 py-2.5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Action</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							for _, dep := range deployments {
								<tr class="hover:bg-gray-50 transition-colors">
									<td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-900">
										<a href={ templ.SafeURL("/deployments/" + dep.ID) } class="text-blue-600 hover:text-blue-800 hover:underline">
											{ dep.ID[:8] }
										</a>
									</td>
									<td class="px-4 py-3 whitespace-nowrap text-sm">
										@components.StatusBadge(string(dep.Status))
									</td>
									<td class="px-4 py-3 whitespace-nowrap text-xs font-mono text-gray-600">
										if dep.ImageName != nil && *dep.ImageName != "" {
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200" title={ *dep.ImageName }>
												<svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
												Cached
											</span>
										} else {
											<span class="text-gray-400">-</span>
										}
									</td>
									<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
										if dep.CommitMessage != nil && *dep.CommitMessage != "" {
											<span class="truncate block max-w-xs">{ *dep.CommitMessage }</span>
										} else if dep.CommitHash != nil && *dep.CommitHash != "" {
											<span class="font-mono text-xs">{ (*dep.CommitHash)[:7] }</span>
										} else {
											<span class="text-gray-400 italic text-xs">Manual trigger</span>
										}
									</td>
									<td class="px-4 py-3 whitespace-nowrap text-xs text-gray-500">
										{ dep.CreatedAt.Format("2006-01-02 15:04") }
									</td>
									<td class="px-4 py-3 whitespace-nowrap text-right text-sm">
										<div class="flex items-center justify-end gap-2">
											<a href={ templ.SafeURL("/deployments/" + dep.ID) } class="text-xs text-gray-600 hover:text-gray-900 px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded transition-colors">
												Logs
											</a>
											if dep.Status == models.DeployStatusSuccess {
												<form action={ templ.SafeURL("/deployments/" + dep.ID + "/rollback") } method="post" class="inline"
												      hx-on:htmx:config-request="this.querySelector('button').disabled=true;this.querySelector('button').innerHTML='Rolling back...'">
													<button type="submit" class="inline-flex items-center gap-1 text-xs bg-amber-500 hover:bg-amber-600 text-white font-medium px-2.5 py-1 rounded shadow-sm transition-colors" title="Instant rollback to this container image">
														<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
														Instant Rollback
													</button>
												</form>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Environment Variables</h2>
			<form action={ templ.SafeURL("/applications/" + app.ID + "/env-vars") } method="post" class="mb-4 flex gap-2">
				<input type="text" name="key" placeholder="KEY" class="border border-gray-300 rounded px-2 py-1 text-sm w-32" required>
				<input type="text" name="value" placeholder="value" class="border border-gray-300 rounded px-2 py-1 text-sm flex-1" required>
				<label class="flex items-center text-sm">
					<input type="checkbox" name="is_secret" class="mr-1">
					Secret
				</label>
				<button type="submit" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">Add</button>
			</form>
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Key</th>
						<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Value</th>
						<th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Action</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, envVar := range envVars {
						<tr>
							<td class="px-4 py-2 text-sm text-gray-900">{ envVar.Key }</td>
							<td class="px-4 py-2 text-sm text-gray-500">
								if envVar.IsSecret {
									••••••••
								} else {
									{ envVar.Value }
								}
							</td>
							<td class="px-4 py-2 text-right">
								<form action={ templ.SafeURL("/applications/" + app.ID + "/env-vars/" + envVar.ID + "/delete") } method="post" class="inline">
									<button type="submit" class="text-red-600 hover:text-red-900 text-sm">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ApplicationCreatePage() {
	<div>
		<h1 class="text-3xl font-bold text-gray-900 mb-6">New Application</h1>
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<form action="/applications" method="post" class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-gray-700">Name</label>
					<input type="text" name="name" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Source Type</label>
					<select name="source_type" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
						<option value="git">Git</option>
						<option value="docker_image">Docker Image</option>
						<option value="dockerfile">Dockerfile</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Repository URL</label>
					<input type="text" name="repository_url" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Docker Image</label>
					<input type="text" name="docker_image" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">App Port</label>
					<input type="number" name="app_port" value="8080" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div class="flex gap-2">
					<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Create Application</button>
					<a href="/projects" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-300">Cancel</a>
				</div>
			</form>
		</div>
	</div>
}
