package applications

import (
	"strconv"

	"github.com/akordium-id/get-labuh/internal/models"
	"github.com/akordium-id/get-labuh/internal/web/components"
)

templ ApplicationsListPage(apps []*models.Application, currentPage, totalPages int, search string) {
	<div>
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
			<h1 class="text-3xl font-bold text-gray-900">Applications</h1>
			<a href="/applications/create" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">New Application</a>
		</div>
		<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
			<div class="p-4 border-b border-gray-200">
				<input type="text"
				       name="search"
				       placeholder="Search applications..."
				       value={ search }
				       hx-trigger="keyup changed delay:500ms"
				       hx-target="#applications-table"
				       hx-swap="innerHTML"
				       class="w-full sm:w-64 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
			</div>
			<div id="applications-table" class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Port</th>
							<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						if len(apps) == 0 {
							<tr>
								<td colspan="5">
									@components.EmptyState("📦", "No applications yet", "Get started by creating your first application", "Create Application", "/applications/create")
								</td>
							</tr>
						} else {
							for _, app := range apps {
								<tr>
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="text-sm font-medium text-gray-900">{ app.Name }</div>
										<div class="text-sm text-gray-500">{ app.Slug }</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ app.SourceType }</td>
									<td class="px-6 py-4 whitespace-nowrap">
										@components.StatusBadge(string(app.Status))
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ formatInt(app.AppPort) }</td>
									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										<a href={ templ.SafeURL("/applications/" + app.ID) } class="text-blue-600 hover:text-blue-900 mr-3">View</a>
										<a href={ templ.SafeURL("/applications/" + app.ID + "/deploy") } class="text-green-600 hover:text-green-900 mr-3">Deploy</a>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
			@components.Pagination(currentPage, totalPages, "/applications")
		</div>
	</div>
}

func formatInt(n int) string {
	if n < 0 {
		return "0"
	}
	if n == 0 {
		return "0"
	}
	var result []byte
	for n > 0 {
		digit := byte('0' + n%10)
		result = append([]byte{digit}, result...)
		n /= 10
	}
	return string(result)
}

func formatCPULimit(val *float64) string {
	if val == nil || *val <= 0 {
		return ""
	}
	return strconv.FormatFloat(*val, 'f', -1, 64)
}

func formatMemLimit(val *int64) string {
	if val == nil || *val <= 0 {
		return ""
	}
	return strconv.FormatInt(*val, 10)
}

templ ApplicationDetailPage(app *models.Application, deployments []*models.Deployment, envVars []*models.AppEnvVar) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">{ app.Name }</h1>
				<p class="text-gray-600 mt-1">{ app.Slug }</p>
			</div>
			<div class="flex gap-2">
				<form action={ templ.SafeURL("/applications/" + app.ID + "/start") } method="post" class="inline">
					<button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">Start</button>
				</form>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/stop") } method="post" class="inline">
					<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Stop</button>
				</form>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/restart") } method="post" class="inline">
					<button type="submit" class="bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700">Restart</button>
				</form>
				<a href={ templ.SafeURL("/applications/" + app.ID + "/deploy") } class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Deploy</a>
				if app.ContainerID != nil && *app.ContainerID != "" {
					<a href={ templ.SafeURL("/applications/" + app.ID + "/terminal") } target="_blank" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-900 flex items-center gap-1.5 font-medium">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
						Terminal
					</a>
				}
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Application Info</h2>
				<dl class="space-y-3">
					<div class="flex justify-between">
						<dt class="text-gray-600">Status</dt>
						<dd class="text-gray-900">{ app.Status }</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">Source Type</dt>
						<dd class="text-gray-900">{ app.SourceType }</dd>
					</div>
					if app.RepositoryURL != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Repository</dt>
							<dd class="text-gray-900">{ *app.RepositoryURL }</dd>
						</div>
					}
					if app.DockerImage != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Image</dt>
							<dd class="text-gray-900">{ *app.DockerImage }</dd>
						</div>
					}
					<div class="flex justify-between">
						<dt class="text-gray-600">App Port</dt>
						<dd class="text-gray-900">{ app.AppPort }</dd>
					</div>
					if app.ContainerID != nil {
						<div class="flex justify-between">
							<dt class="text-gray-600">Container ID</dt>
							<dd class="text-gray-900 font-mono text-sm">{ *app.ContainerID }</dd>
						</div>
					}
				</dl>
			</div>

			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Custom Domain</h2>
				if app.CustomDomain != nil {
					<dl class="space-y-3 mb-4">
						<div class="flex justify-between">
							<dt class="text-gray-600">Domain</dt>
							<dd class="text-gray-900">{ *app.CustomDomain }</dd>
						</div>
						<div class="flex justify-between">
							<dt class="text-gray-600">HTTPS</dt>
							<dd class="text-green-600">Enabled (via Caddy)</dd>
						</div>
					</dl>
					<form action={ templ.SafeURL("/applications/" + app.ID + "/domain/remove") } method="post" class="inline">
						<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Remove Domain</button>
					</form>
				} else {
					<form action={ templ.SafeURL("/applications/" + app.ID + "/domain") } method="post" class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700">Custom Domain</label>
							<input type="text" name="custom_domain" placeholder="example.com" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" required>
						</div>
						<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Set Domain</button>
					</form>
				}
			</div>

			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<h2 class="text-xl font-bold text-gray-900 mb-1">Resource Limits</h2>
				<p class="text-xs text-gray-500 mb-4">Batas CPU & RAM container (Live update)</p>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/resources") } method="post" class="space-y-3">
					<div>
						<label class="block text-xs font-semibold text-gray-700">CPU Limit (Cores, e.g. 0.5, 1.0)</label>
						<input type="number" step="0.1" min="0.1" name="cpu_limit"
							value={ formatCPULimit(app.CPULimit) }
							placeholder="Unlimited (e.g. 1.0)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Memory Limit (MB, e.g. 512, 1024)</label>
						<input type="number" min="32" name="memory_limit"
							value={ formatMemLimit(app.MemoryLimit) }
							placeholder="Unlimited (e.g. 512)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Memory Reservation / Soft Limit (MB)</label>
						<input type="number" min="16" name="memory_reservation"
							value={ formatMemLimit(app.MemoryReservation) }
							placeholder="Optional (e.g. 256)"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm"/>
					</div>
					<button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 rounded-md">
						Save & Apply Limits
					</button>
				</form>
			</div>
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<div class="flex justify-between items-center mb-4">
				<div>
					<h2 class="text-xl font-bold text-gray-900">Git Webhook & Auto-Deploy</h2>
					<p class="text-xs text-gray-500 mt-1">Otomatiskan deploy setiap kali ada push commit ke target branch.</p>
				</div>
				<form action={ templ.SafeURL("/applications/" + app.ID + "/webhook/regenerate") } method="post" class="inline">
					<button type="submit" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded border border-gray-300 font-medium">
						Regenerate Secret
					</button>
				</form>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
				<div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
					<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">GitHub Webhook URL</span>
					<div class="flex items-center gap-2">
						<input type="text" readonly value={ "/webhooks/github/" + app.ID } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
					</div>
					<span class="text-[11px] text-gray-400 mt-1 block">Content type: application/json • Secret token: required</span>
				</div>
				<div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
					<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">GitLab Webhook URL</span>
					<div class="flex items-center gap-2">
						<input type="text" readonly value={ "/webhooks/gitlab/" + app.ID } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
					</div>
					<span class="text-[11px] text-gray-400 mt-1 block">Trigger: Push events • Secret token: required</span>
				</div>
			</div>

			<div class="p-3 bg-gray-50 rounded-lg border border-gray-200 mb-4">
				<span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">Webhook Secret</span>
				if app.WebhookSecret != nil && *app.WebhookSecret != "" {
					<input type="text" readonly value={ *app.WebhookSecret } class="font-mono text-xs bg-white border border-gray-300 rounded px-2 py-1.5 w-full text-gray-800" onclick="this.select()"/>
				} else {
					<span class="text-xs text-amber-600 italic">Belum ada secret. Klik Regenerate Secret di atas untuk mengaktifkannya.</span>
				}
			</div>

			<div class="text-xs text-gray-500 bg-blue-50 border border-blue-200 rounded p-3">
				<strong class="text-blue-800">Petunjuk Konfigurasi:</strong>
				<ul class="list-disc list-inside mt-1 space-y-1 text-blue-700">
					<li><strong>GitHub:</strong> Buka Repo Settings &rarr; Webhooks &rarr; Add Webhook. Masukkan URL GitHub di atas, pilih Content type: <code class="bg-blue-100 px-1 py-0.5 rounded">application/json</code>, isi Secret, dan pilih event <em>Just the push event</em>.</li>
					<li><strong>GitLab:</strong> Buka Repo Settings &rarr; Webhooks. Masukkan URL GitLab, paste Secret Token, dan centang event <em>Push events</em>.</li>
					<li><strong>Filter Otomatis:</strong> Push ke branch lain akan diabaikan tanpa error demi menghemat resource server.</li>
				</ul>
			</div>
		</div>

		<div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-xl font-bold text-gray-900 mb-4">Environment Variables</h2>
			<form action={ templ.SafeURL("/applications/" + app.ID + "/env-vars") } method="post" class="mb-4 flex gap-2">
				<input type="text" name="key" placeholder="KEY" class="border border-gray-300 rounded px-2 py-1 text-sm w-32" required>
				<input type="text" name="value" placeholder="value" class="border border-gray-300 rounded px-2 py-1 text-sm flex-1" required>
				<label class="flex items-center text-sm">
					<input type="checkbox" name="is_secret" class="mr-1">
					Secret
				</label>
				<button type="submit" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">Add</button>
			</form>
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Key</th>
						<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Value</th>
						<th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Action</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, envVar := range envVars {
						<tr>
							<td class="px-4 py-2 text-sm text-gray-900">{ envVar.Key }</td>
							<td class="px-4 py-2 text-sm text-gray-500">
								if envVar.IsSecret {
									••••••••
								} else {
									{ envVar.Value }
								}
							</td>
							<td class="px-4 py-2 text-right">
								<form action={ templ.SafeURL("/applications/" + app.ID + "/env-vars/" + envVar.ID + "/delete") } method="post" class="inline">
									<button type="submit" class="text-red-600 hover:text-red-900 text-sm">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ApplicationCreatePage() {
	<div>
		<h1 class="text-3xl font-bold text-gray-900 mb-6">New Application</h1>
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<form action="/applications" method="post" class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-gray-700">Name</label>
					<input type="text" name="name" required class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Source Type</label>
					<select name="source_type" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
						<option value="git">Git</option>
						<option value="docker_image">Docker Image</option>
						<option value="dockerfile">Dockerfile</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Repository URL</label>
					<input type="text" name="repository_url" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Docker Image</label>
					<input type="text" name="docker_image" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">App Port</label>
					<input type="number" name="app_port" value="8080" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2">
				</div>
				<div class="flex gap-2">
					<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Create Application</button>
					<a href="/projects" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-300">Cancel</a>
				</div>
			</form>
		</div>
	</div>
}
