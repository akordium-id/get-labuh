package settings

import (
	"github.com/akordium-id/get-labuh/internal/models"
)

templ APIKeysPage(apiKeys []*models.ApiKey) {
	<div>
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold text-gray-900">API Keys</h1>
			<form action="/settings/api-keys/create" method="post" class="inline">
				<button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Generate New Key</button>
			</form>
		</div>
		<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used</th>
						<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					if len(apiKeys) == 0 {
						<tr>
							<td colspan="4" class="px-6 py-4 text-center text-gray-500">No API keys yet</td>
						</tr>
					} else {
						for _, apiKey := range apiKeys {
							<tr>
								<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{ apiKey.Name }</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ apiKey.CreatedAt.Format("2006-01-02 15:04:05") }</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
									if apiKey.LastUsedAt != nil {
										{ apiKey.LastUsedAt.Format("2006-01-02 15:04:05") }
									} else {
										Never
									}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
									<form action={ templ.SafeURL("/settings/api-keys/" + apiKey.ID + "/delete") } method="post" class="inline" onsubmit="return confirm('Are you sure?')">
										<button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
									</form>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ APIKeyCreatePage(apiKey *models.ApiKey, rawKey string) {
	<div>
		<div class="mb-6">
			<h1 class="text-3xl font-bold text-gray-900">API Key Created</h1>
			<p class="text-gray-600 mt-1">Your API key has been created. Copy it now - you won't be able to see it again.</p>
		</div>
		<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-6">
			<div class="flex items-center justify-between">
				<code class="text-sm font-mono bg-yellow-100 px-3 py-2 rounded flex-1 mr-4">{ rawKey }</code>
				<button onclick="navigator.clipboard.writeText('{ rawKey }')" class="bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700">Copy</button>
			</div>
		</div>
		<div class="flex gap-2">
			<a href="/settings/api-keys" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Done</a>
		</div>
	</div>
}
