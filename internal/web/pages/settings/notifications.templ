package settings

import "github.com/akordium-id/get-labuh/internal/models"

templ NotificationsPage(channels []*models.NotificationChannel, projects []*models.Project) {
	<div>
		<div class="flex space-x-4 border-b border-gray-200 mb-6">
			<a href="/settings/api-keys" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">API Keys</a>
			<a href="/settings/notifications" class="py-2 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600">Notification Channels</a>
		</div>

		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Notification Channels</h1>
				<p class="text-gray-600 mt-1">Kirim alert status deployment dan backup ke Discord Webhook atau Telegram Bot.</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
			<!-- Daftar Channel yang Ada -->
			<div class="lg:col-span-2 space-y-4">
				<h2 class="text-xl font-bold text-gray-900">Configured Channels ({ string(rune('0' + len(channels))) })</h2>
				if len(channels) == 0 {
					<div class="bg-white rounded-lg shadow border border-dashed border-gray-300 p-8 text-center">
						<p class="text-gray-500 text-sm">Belum ada channel notifikasi yang dikonfigurasi.</p>
						<p class="text-gray-400 text-xs mt-1">Tambahkan webhook Discord atau bot Telegram menggunakan form di samping.</p>
					</div>
				}
				for _, ch := range channels {
					<div class="bg-white rounded-lg shadow border border-gray-200 p-5">
						<div class="flex justify-between items-start">
							<div>
								<div class="flex items-center gap-2">
									<h3 class="text-lg font-bold text-gray-900">{ ch.Name }</h3>
									if ch.Type == "discord" {
										<span class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-0.5 rounded">Discord</span>
									} else {
										<span class="bg-sky-100 text-sky-800 text-xs font-semibold px-2.5 py-0.5 rounded">Telegram</span>
									}
									if ch.ProjectID == nil {
										<span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">Global (All Projects)</span>
									} else {
										<span class="bg-purple-100 text-purple-800 text-xs font-semibold px-2.5 py-0.5 rounded">Project Override</span>
									}
								</div>

								<div class="text-xs text-gray-500 mt-2 space-y-1">
									if ch.Type == "discord" && ch.DiscordWebhookURL != nil {
										<p class="font-mono text-gray-600 truncate max-w-md">Webhook: { *ch.DiscordWebhookURL }</p>
									} else if ch.Type == "telegram" && ch.TelegramChatID != nil {
										<p class="font-mono text-gray-600">Chat ID: { *ch.TelegramChatID }</p>
									}
									<div class="flex gap-2 flex-wrap pt-1">
										if ch.OnDeploySuccess {
											<span class="bg-green-50 text-green-700 text-[11px] px-2 py-0.5 rounded border border-green-200">Deploy Sukses</span>
										}
										if ch.OnDeployFailure {
											<span class="bg-red-50 text-red-700 text-[11px] px-2 py-0.5 rounded border border-red-200">Deploy Gagal</span>
										}
										if ch.OnBackupSuccess {
											<span class="bg-emerald-50 text-emerald-700 text-[11px] px-2 py-0.5 rounded border border-emerald-200">Backup Sukses</span>
										}
										if ch.OnBackupFailure {
											<span class="bg-rose-50 text-rose-700 text-[11px] px-2 py-0.5 rounded border border-rose-200">Backup Gagal</span>
										}
									</div>
								</div>
							</div>

							<div class="flex items-center gap-2">
								<form action={ templ.SafeURL("/settings/notifications/" + ch.ID + "/test") } method="post" class="inline">
									<button type="submit" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded font-medium border border-gray-300">
										Send Test
									</button>
								</form>
								<form action={ templ.SafeURL("/settings/notifications/" + ch.ID + "/delete") } method="post" class="inline" onsubmit="return confirm('Hapus channel notifikasi ini?')">
									<button type="submit" class="text-xs bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded font-medium border border-red-200">
										Delete
									</button>
								</form>
							</div>
						</div>
					</div>
				}
			</div>

			<!-- Form Tambah Channel Baru -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6" x-data="{ channelType: 'discord' }">
				<h2 class="text-xl font-bold text-gray-900 mb-4">Add Channel</h2>
				<form action="/settings/notifications" method="post" class="space-y-3">
					<div>
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Nama Channel</label>
						<input type="text" name="name" placeholder="Tim DevOps Discord" required class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm"/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Channel Type</label>
						<select name="type" x-model="channelType" class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm bg-white">
							<option value="discord">Discord Webhook</option>
							<option value="telegram">Telegram Bot</option>
						</select>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Scope Notifikasi</label>
						<select name="project_id" class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm bg-white">
							<option value="">Global (Semua Project & Database)</option>
							for _, p := range projects {
								<option value={ p.ID }>Project: { p.Name }</option>
							}
						</select>
					</div>

					<!-- Field Discord -->
					<div x-show="channelType === 'discord'">
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Discord Webhook URL</label>
						<input type="url" name="discord_webhook_url" placeholder="https://discord.com/api/webhooks/..." class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm font-mono"/>
					</div>

					<!-- Fields Telegram -->
					<div x-show="channelType === 'telegram'" class="space-y-3">
						<div>
							<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Telegram Bot Token</label>
							<input type="text" name="telegram_bot_token" placeholder="123456789:ABCdefGhIJKlmNoPQRstuVWXyz" class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm font-mono"/>
						</div>
						<div>
							<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Telegram Chat ID</label>
							<input type="text" name="telegram_chat_id" placeholder="-1001234567890 atau @channel_name" class="mt-1 block w-full border border-gray-300 rounded px-3 py-1.5 text-sm font-mono"/>
						</div>
					</div>

					<!-- Event Toggles -->
					<div class="pt-2 border-t border-gray-100">
						<label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">Triggers</label>
						<div class="space-y-1.5">
							<label class="flex items-center text-xs text-gray-700">
								<input type="checkbox" name="on_deploy_success" value="true" checked class="mr-2"/>
								Deploy Sukses
							</label>
							<label class="flex items-center text-xs text-gray-700">
								<input type="checkbox" name="on_deploy_failure" value="true" checked class="mr-2"/>
								Deploy Gagal
							</label>
							<label class="flex items-center text-xs text-gray-700">
								<input type="checkbox" name="on_backup_success" value="true" checked class="mr-2"/>
								Backup Database Sukses
							</label>
							<label class="flex items-center text-xs text-gray-700">
								<input type="checkbox" name="on_backup_failure" value="true" checked class="mr-2"/>
								Backup Database Gagal
							</label>
						</div>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded text-sm mt-3">
						Simpan Channel
					</button>
				</form>
			</div>
		</div>
	</div>
}
