package settings

import (
	"fmt"
	"github.com/akordium-id/get-labuh/internal/observability"
)

func formatHostBytes(b uint64) string {
	if b < 1024 {
		return fmt.Sprintf("%d B", b)
	}
	if b < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(b)/1024)
	}
	if b < 1024*1024*1024 {
		return fmt.Sprintf("%.1f MB", float64(b)/(1024*1024))
	}
	return fmt.Sprintf("%.1f GB", float64(b)/(1024*1024*1024))
}

func getSettingVal(m map[string]string, key, defaultVal string) string {
	if v, ok := m[key]; ok && v != "" {
		return v
	}
	return defaultVal
}

templ MonitoringPage(stats observability.HostStats, settings map[string]string) {
	<div>
		<div class="flex space-x-4 border-b border-gray-200 mb-6">
			<a href="/settings/api-keys" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">API Keys</a>
			<a href="/settings/notifications" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">Notification Channels</a>
			<a href="/settings/registries" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">Docker Registries</a>
			<a href="/settings/monitoring" class="py-2 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600">Server Monitoring</a>
		</div>

		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Server Resource Monitoring</h1>
				<p class="text-gray-600 mt-1">Pantau pemakaian Disk, RAM, dan CPU host server, serta kelola batas ambang notifikasi proaktif.</p>
			</div>
			<div class="flex items-center gap-2">
				<form action="/settings/monitoring/test" method="post" class="inline">
					<button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold px-3 py-2 rounded-md border border-gray-300 transition-colors flex items-center gap-1.5 shadow-xs">
						<svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
						Kirim Uji Coba Alert
					</button>
				</form>
				<a href="/settings/monitoring" class="bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-2 rounded-md border border-blue-200 transition-colors flex items-center gap-1.5">
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
					Refresh Stats
				</a>
			</div>
		</div>

		<!-- Realtime Resource Cards -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
			<!-- Disk Card -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<div class="flex justify-between items-start mb-2">
					<span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Host Storage (Root /)</span>
					<span class={ "text-xs font-bold px-2 py-0.5 rounded", func() string {
						if stats.DiskUsedPercent >= 90 { return "bg-rose-100 text-rose-800" }
						if stats.DiskUsedPercent >= 80 { return "bg-amber-100 text-amber-800" }
						return "bg-emerald-100 text-emerald-800"
					}() }>
						{ fmt.Sprintf("%.1f%%", stats.DiskUsedPercent) }
					</span>
				</div>
				<div class="text-2xl font-black text-gray-900 mb-3">
					{ formatHostBytes(stats.DiskUsed) } <span class="text-sm font-normal text-gray-500">/ { formatHostBytes(stats.DiskTotal) }</span>
				</div>
				<div class="w-full bg-gray-100 rounded-full h-2.5 mb-2 overflow-hidden">
					<div class={ "h-2.5 rounded-full", func() string {
						if stats.DiskUsedPercent >= 90 { return "bg-rose-600" }
						if stats.DiskUsedPercent >= 80 { return "bg-amber-500" }
						return "bg-emerald-500"
					}() } style={ fmt.Sprintf("width: %.1f%%", stats.DiskUsedPercent) }></div>
				</div>
				<p class="text-xs text-gray-500">Sisa kapasitas tersedia: <span class="font-semibold text-gray-700">{ formatHostBytes(stats.DiskFree) }</span></p>
			</div>

			<!-- RAM Card -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<div class="flex justify-between items-start mb-2">
					<span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Host RAM Memory</span>
					<span class={ "text-xs font-bold px-2 py-0.5 rounded", func() string {
						if stats.MemUsedPercent >= 90 { return "bg-rose-100 text-rose-800" }
						if stats.MemUsedPercent >= 80 { return "bg-amber-100 text-amber-800" }
						return "bg-emerald-100 text-emerald-800"
					}() }>
						{ fmt.Sprintf("%.1f%%", stats.MemUsedPercent) }
					</span>
				</div>
				<div class="text-2xl font-black text-gray-900 mb-3">
					{ formatHostBytes(stats.MemUsed) } <span class="text-sm font-normal text-gray-500">/ { formatHostBytes(stats.MemTotal) }</span>
				</div>
				<div class="w-full bg-gray-100 rounded-full h-2.5 mb-2 overflow-hidden">
					<div class={ "h-2.5 rounded-full", func() string {
						if stats.MemUsedPercent >= 90 { return "bg-rose-600" }
						if stats.MemUsedPercent >= 80 { return "bg-amber-500" }
						return "bg-indigo-600"
					}() } style={ fmt.Sprintf("width: %.1f%%", stats.MemUsedPercent) }></div>
				</div>
				<p class="text-xs text-gray-500">Sisa memori tersedia: <span class="font-semibold text-gray-700">{ formatHostBytes(stats.MemFree) }</span></p>
			</div>

			<!-- CPU Load Card -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
				<div class="flex justify-between items-start mb-2">
					<span class="text-xs font-bold text-gray-500 uppercase tracking-wider">CPU Load Average</span>
					<span class="text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded">
						{ fmt.Sprintf("%d Cores", stats.CPUNum) }
					</span>
				</div>
				<div class="text-2xl font-black text-gray-900 mb-3">
					{ fmt.Sprintf("%.2f", stats.CPULoad1) } <span class="text-xs font-normal text-gray-500">(1 min)</span>
				</div>
				<div class="grid grid-cols-2 gap-2 pt-2 border-t border-gray-100 text-xs">
					<div>
						<span class="text-gray-400 block">Load 5 min:</span>
						<span class="font-mono font-semibold text-gray-800">{ fmt.Sprintf("%.2f", stats.CPULoad5) }</span>
					</div>
					<div>
						<span class="text-gray-400 block">Load 15 min:</span>
						<span class="font-mono font-semibold text-gray-800">{ fmt.Sprintf("%.2f", stats.CPULoad15) }</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Configuration Form -->
		<div class="bg-white rounded-lg shadow border border-gray-200 p-6">
			<h2 class="text-lg font-bold text-gray-900 mb-1">Ambang Batas &amp; Otomatisasi Alert</h2>
			<p class="text-xs text-gray-500 mb-6">Daemon background akan memantau server setiap menit dan mengirimkan alert saat ambang batas terlampaui.</p>

			<form action="/settings/monitoring" method="post" class="space-y-6 max-w-2xl">
				<div class="flex items-start gap-2.5">
					<input type="checkbox" id="host_monitoring_enabled" name="host_monitoring_enabled" value="true"
						checked?={ getSettingVal(settings, "host_monitoring_enabled", "true") == "true" }
						class="rounded border-gray-300 text-blue-600 shadow-xs focus:ring-blue-500 mt-0.5"/>
					<label for="host_monitoring_enabled" class="text-xs font-semibold text-gray-800 select-none">
						Aktifkan Proactive Resource Monitoring Daemon
						<span class="block font-normal text-[11px] text-gray-500">Evaluasi otomatis berkala dan pengiriman alert ke Discord, Telegram, atau Webhook yang aktif.</span>
					</label>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-semibold text-gray-700">Disk Warning Threshold (%)</label>
						<input type="number" min="50" max="99" name="host_disk_warning_pct"
							value={ getSettingVal(settings, "host_disk_warning_pct", "80") }
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono" required/>
						<span class="text-[10px] text-gray-400 mt-0.5 block">Default: 80%. Memicu alert bertipe Warning.</span>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700">Disk Critical Threshold (%)</label>
						<input type="number" min="50" max="99" name="host_disk_critical_pct"
							value={ getSettingVal(settings, "host_disk_critical_pct", "90") }
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono" required/>
						<span class="text-[10px] text-gray-400 mt-0.5 block">Default: 90%. Memicu alert bertipe Critical (prioritas tinggi).</span>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700">RAM Warning Threshold (%)</label>
						<input type="number" min="50" max="99" name="host_ram_warning_pct"
							value={ getSettingVal(settings, "host_ram_warning_pct", "90") }
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono" required/>
						<span class="text-[10px] text-gray-400 mt-0.5 block">Default: 90%. Memicu peringatan konsumsi RAM tinggi.</span>
					</div>

					<div>
						<label class="block text-xs font-semibold text-gray-700">Anti-Spam Cooldown Window (Menit)</label>
						<input type="number" min="5" max="1440" name="host_alert_cooldown_minutes"
							value={ getSettingVal(settings, "host_alert_cooldown_minutes", "30") }
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono" required/>
						<span class="text-[10px] text-gray-400 mt-0.5 block">Default: 30 menit. Jeda waktu sebelum mengirim alert pengingat berikutnya jika kondisi belum pulih.</span>
					</div>
				</div>

				<div class="pt-2">
					<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2 rounded-md shadow-xs transition-colors">
						Simpan Pengaturan Monitoring
					</button>
				</div>
			</form>
		</div>
	</div>
}
