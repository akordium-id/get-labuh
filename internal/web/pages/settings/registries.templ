package settings

import (
	"strconv"

	"github.com/akordium-id/get-labuh/internal/models"
)

templ RegistriesPage(registries []*models.DockerRegistry) {
	<div>
		<div class="flex space-x-4 border-b border-gray-200 mb-6">
			<a href="/settings/api-keys" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">API Keys</a>
			<a href="/settings/notifications" class="py-2 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300">Notification Channels</a>
			<a href="/settings/registries" class="py-2 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600">Docker Registries</a>
		</div>

		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold text-gray-900">Private Docker Registries</h1>
				<p class="text-gray-600 mt-1">Konfigurasi autentikasi untuk pull image dari GitHub Packages (GHCR), Docker Hub Private, AWS ECR, GitLab, atau Harbor.</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
			<!-- Registry List -->
			<div class="lg:col-span-2 space-y-4">
				<h2 class="text-xl font-bold text-gray-900">Tersedia ({ strconv.Itoa(len(registries)) })</h2>
				if len(registries) == 0 {
					<div class="bg-white rounded-lg shadow border border-dashed border-gray-300 p-8 text-center">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
						</svg>
						<p class="text-gray-500 text-sm mt-3">Belum ada Docker Registry private yang dikonfigurasi.</p>
						<p class="text-gray-400 text-xs mt-1">Tambahkan kredensial GHCR atau Docker Hub Anda menggunakan form di samping.</p>
					</div>
				}
				for _, r := range registries {
					<div class="bg-white rounded-lg shadow border border-gray-200 p-5">
						<div class="flex justify-between items-start">
							<div>
								<div class="flex items-center gap-2">
									<h3 class="text-lg font-bold text-gray-900">{ r.Name }</h3>
									<span class="bg-indigo-50 text-indigo-700 text-xs font-semibold px-2 py-0.5 rounded border border-indigo-200">{ r.ServerAddress }</span>
								</div>
								<div class="mt-2 text-xs text-gray-600 space-y-1">
									<p><span class="font-medium text-gray-500">Username:</span> <span class="font-mono bg-gray-100 px-1.5 py-0.5 rounded">{ r.Username }</span></p>
									if r.Email != "" {
										<p><span class="font-medium text-gray-500">Email:</span> { r.Email }</p>
									}
									<p><span class="font-medium text-gray-500">Ditambahkan:</span> { r.CreatedAt.Format("2006-01-02 15:04:05") }</p>
								</div>
							</div>
							<div class="flex items-center gap-2">
								<form action={ templ.SafeURL("/settings/registries/" + r.ID + "/delete") } method="post" onsubmit="return confirm('Yakin ingin menghapus kredensial registry ini? Aplikasi yang menggunakannya tidak akan bisa pull image private.');">
									<button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-semibold px-2 py-1 border border-rose-200 rounded hover:bg-rose-50 transition-colors">
										Hapus
									</button>
								</form>
							</div>
						</div>
					</div>
				}
			</div>

			<!-- Add Form -->
			<div class="bg-white rounded-lg shadow border border-gray-200 p-6 h-fit">
				<h2 class="text-lg font-bold text-gray-900 mb-1">Tambah Registry Baru</h2>
				<p class="text-xs text-gray-500 mb-4">Password/Token akan dienkripsi secara aman dengan AES-256-GCM.</p>
				<form action="/settings/registries" method="post" class="space-y-4">
					<div>
						<label class="block text-xs font-semibold text-gray-700">Nama Registry</label>
						<input type="text" name="name" required placeholder="GitHub Packages Production"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs shadow-xs focus:ring-blue-500 focus:border-blue-500"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Server Address</label>
						<input type="text" name="server_address" required placeholder="ghcr.io atau index.docker.io/v1/"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono shadow-xs focus:ring-blue-500 focus:border-blue-500"/>
						<span class="text-[10px] text-gray-400 mt-0.5 block">Contoh: ghcr.io, docker.io, 12345.dkr.ecr.us-east-1.amazonaws.com</span>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Username</label>
						<input type="text" name="username" required placeholder="akordium-bot"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono shadow-xs focus:ring-blue-500 focus:border-blue-500"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Password / Access Token</label>
						<input type="password" name="password" required placeholder="ghp_... atau token rahasia"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs font-mono shadow-xs focus:ring-blue-500 focus:border-blue-500"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-gray-700">Email (Opsional)</label>
						<input type="email" name="email" placeholder="dev@example.com"
							class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-1.5 text-xs shadow-xs focus:ring-blue-500 focus:border-blue-500"/>
					</div>
					<div class="pt-2 flex flex-col gap-2">
						<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-2 rounded-md transition-colors shadow-xs">
							Simpan Registry
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
