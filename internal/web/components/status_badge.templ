package components

import "github.com/akordium-id/get-labuh/internal/models"

templ StatusBadge(status string) {
	<span class={ "px-2 inline-flex text-xs leading-5 font-semibold rounded-full " + statusColor(status) }>
		{ status }
	</span>
}

func statusColor(status string) string {
	switch status {
	case string(models.DeployStatusQueued):
		return "bg-gray-100 text-gray-800"
	case string(models.DeployStatusCloning):
		return "bg-blue-100 text-blue-800"
	case string(models.DeployStatusBuilding):
		return "bg-yellow-100 text-yellow-800"
	case string(models.DeployStatusDeploying):
		return "bg-orange-100 text-orange-800"
	case string(models.DeployStatusSuccess):
		return "bg-green-100 text-green-800"
	case string(models.DeployStatusFailed):
		return "bg-red-100 text-red-800"
	case string(models.DeployStatusCancelled):
		return "bg-gray-100 text-gray-800"
	case string(models.AppStatusRunning):
		return "bg-green-100 text-green-800"
	case string(models.AppStatusStopped):
		return "bg-gray-100 text-gray-800"
	case string(models.AppStatusIdle):
		return "bg-gray-100 text-gray-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}
