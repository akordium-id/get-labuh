package components

import "github.com/akordium-id/get-labuh/internal/models"

templ StatusBadge(status string) {
	<span class={ "px-2.5 py-0.5 inline-flex items-center gap-1.5 text-xs leading-5 font-semibold rounded-full " + statusColor(status) }>
		if isLiveStatus(status) {
			<span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
		}
		{ status }
	</span>
}

templ PollingStatusBadge(status, endpoint string) {
	<span id="status-badge"
	      class={ "px-2.5 py-0.5 inline-flex items-center gap-1.5 text-xs leading-5 font-semibold rounded-full " + statusColor(status) }
	      hx-get={ endpoint }
	      hx-trigger={ getPollingTrigger(status) }
	      hx-swap="outerHTML">
		if isLiveStatus(status) {
			<span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
		}
		{ status }
	</span>
}

func statusColor(status string) string {
	switch status {
	case string(models.DeployStatusQueued):
		return "bg-gray-100 text-gray-800"
	case string(models.DeployStatusCloning):
		return "bg-blue-100 text-blue-800"
	case string(models.DeployStatusBuilding):
		return "bg-yellow-100 text-yellow-800"
	case string(models.DeployStatusDeploying):
		return "bg-orange-100 text-orange-800"
	case string(models.DeployStatusSuccess):
		return "bg-green-100 text-green-800"
	case string(models.DeployStatusFailed):
		return "bg-red-100 text-red-800"
	case string(models.DeployStatusCancelled):
		return "bg-gray-100 text-gray-800"
	case string(models.AppStatusRunning):
		return "bg-green-100 text-green-800"
	case string(models.AppStatusStopped):
		return "bg-gray-100 text-gray-800"
	case string(models.AppStatusIdle):
		return "bg-gray-100 text-gray-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

func isLiveStatus(status string) bool {
	switch status {
	case string(models.AppStatusRunning),
		string(models.DeployStatusCloning),
		string(models.DeployStatusBuilding),
		string(models.DeployStatusDeploying):
		return true
	default:
		return false
	}
}

func getPollingTrigger(status string) string {
	// Jika sedang proses transisi deploy, polling lebih cepat (2s).
	// Jika sudah terminal/stabil, polling santai tiap 4s agar server tetap ringan.
	switch status {
	case string(models.DeployStatusCloning),
		string(models.DeployStatusBuilding),
		string(models.DeployStatusDeploying):
		return "every 2s"
	default:
		return "every 4s"
	}
}
