package components

import (
	"fmt"

	"github.com/akordium-id/get-labuh/internal/models"
)

templ MetricsCard(stats models.ContainerStats, endpoint string) {
	<div id="metrics-card"
	     hx-get={ endpoint }
	     hx-trigger="every 3s"
	     hx-swap="outerHTML"
	     class="bg-white rounded-lg shadow border border-gray-200 p-6">
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center gap-2">
				<h2 class="text-xl font-bold text-gray-900">Live Resource Usage</h2>
				<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" title="Live Polling (3s)"></span>
			</div>
			<span class="text-[11px] font-mono text-gray-400">auto-updating</span>
		</div>

		<div class="space-y-4">
			<div>
				<div class="flex justify-between items-center text-xs mb-1">
					<span class="font-medium text-gray-600">CPU Usage</span>
					<span class="font-mono font-semibold text-gray-900">{ fmt.Sprintf("%.1f%%", stats.CPUPercent) }</span>
				</div>
				<div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
					<div class={ "h-2 rounded-full transition-all duration-500 " + getCPUProgressColor(stats.CPUPercent) }
					     style={ fmt.Sprintf("width: %d%%", getBoundedPercent(stats.CPUPercent)) }></div>
				</div>
			</div>

			<div>
				<div class="flex justify-between items-center text-xs mb-1">
					<span class="font-medium text-gray-600">Memory</span>
					<span class="font-mono font-semibold text-gray-900">
						{ formatBytes(stats.MemoryUsage) }
						if stats.MemoryLimit > 0 {
							/ { formatBytes(stats.MemoryLimit) }
						}
					</span>
				</div>
				<div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
					<div class={ "h-2 rounded-full transition-all duration-500 " + getMemProgressColor(stats.MemoryUsage, stats.MemoryLimit) }
					     style={ fmt.Sprintf("width: %d%%", getMemPercent(stats.MemoryUsage, stats.MemoryLimit)) }></div>
				</div>
			</div>

			<div class="pt-2 border-t border-gray-100 grid grid-cols-2 gap-2 text-xs">
				<div class="flex flex-col">
					<span class="text-gray-400 text-[11px]">Network Rx</span>
					<span class="font-mono font-medium text-gray-700">{ formatBytes(stats.NetworkRx) }</span>
				</div>
				<div class="flex flex-col text-right">
					<span class="text-gray-400 text-[11px]">Network Tx</span>
					<span class="font-mono font-medium text-gray-700">{ formatBytes(stats.NetworkTx) }</span>
				</div>
			</div>
		</div>
	</div>
}

func getBoundedPercent(p float64) int {
	if p < 0 {
		return 0
	}
	if p > 100 {
		return 100
	}
	return int(p)
}

func getCPUProgressColor(p float64) string {
	if p > 80 {
		return "bg-red-500"
	}
	if p > 50 {
		return "bg-amber-500"
	}
	return "bg-blue-600"
}

func getMemPercent(usage, limit uint64) int {
	if limit == 0 {
		return 0
	}
	pct := int((float64(usage) / float64(limit)) * 100)
	if pct > 100 {
		return 100
	}
	return pct
}

func getMemProgressColor(usage, limit uint64) string {
	pct := getMemPercent(usage, limit)
	if pct > 85 {
		return "bg-red-500"
	}
	if pct > 65 {
		return "bg-amber-500"
	}
	return "bg-indigo-600"
}

func formatBytes(b uint64) string {
	if b < 1024 {
		return fmt.Sprintf("%d B", b)
	}
	if b < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(b)/1024)
	}
	if b < 1024*1024*1024 {
		return fmt.Sprintf("%.1f MB", float64(b)/(1024*1024))
	}
	return fmt.Sprintf("%.1f GB", float64(b)/(1024*1024*1024))
}
