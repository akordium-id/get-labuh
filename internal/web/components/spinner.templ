package components

templ Spinner(size, color string) {
	<span class={ "inline-block animate-spin rounded-full border-2 border-t-transparent " + spinnerSize(size) + " " + spinnerColor(color) }></span>
}

func spinnerSize(size string) string {
	switch size {
	case "sm":
		return "h-4 w-4"
	case "lg":
		return "h-8 w-8"
	default:
		return "h-5 w-5"
	}
}

func spinnerColor(color string) string {
	switch color {
	case "green":
		return "border-green-600"
	case "red":
		return "border-red-600"
	case "gray":
		return "border-gray-600"
	case "white":
		return "border-white"
	default:
		return "border-blue-600"
	}
}
